# Neon Lakebase Postgres
DATABASE_URL=postgresql://neondb_owner:your-password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:your-password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require
NEON_BRANCH=production

# Groq AI (Legal Report Generation & Research Dossiers)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=qwen/qwen3.8-27b

# Authentication / JWT
JWT_SECRET=your-secure-jwt-secret-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Application Server
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8001
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
